# Copy this file to .env and fill in local values.
#   copy .env.example .env

# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
# Staging/production: add the EC2 public IP or domain, e.g.
# ALLOWED_HOSTS=54.x.x.x,staging.example.com

# Browser frontends that may call this API. Use full origins (scheme + host + port).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Set true only for temporary local testing. Do not enable in production.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AWS / S3 (Sydney)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=gaadis3
AWS_S3_REGION_NAME=ap-southeast-2
AWS_S3_QUERYSTRING_AUTH=True

# Database
DATABASE_NAME=gaadidb
DATABASE_USER=admin
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# Uploaded constituency, vehicle, driver, and document files
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Auth / JWT
ACCESS_TOKEN_HOURS=1
REFRESH_TOKEN_DAYS=7

# Throttling
THROTTLE_ANON=30/minute
THROTTLE_USER=120/minute
THROTTLE_LOGIN=5/minute

# Logging
LOG_LEVEL=INFO
