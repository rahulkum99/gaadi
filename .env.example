#   copy .env.example .env

# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database
DATABASE_NAME=gaadidb
DATABASE_USER=admin
DATABASE_PASSWORD=
